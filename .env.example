# HTTP port (this repo uses 4101)
PORT=4101
# SQLite file for routing state, squads overlay, audit, AI ledger and the knowledge base
ROUTER_DB_PATH=data/runtime/router.db

# Routing
ROUTING_ENABLED=1
ROUTING_DRY_RUN=0
TRIAGE_AGENT_ID=1900
N1_FALLBACK_MINUTES=30
SQUAD_EDITOR_ENABLED=1

# Poller over the (fake) helpdesk
POLLER_ENABLED=0
POLL_INTERVAL_SECONDS=30

# AI classifier: "fake" (deterministic, default) or "anthropic" (needs ANTHROPIC_API_KEY)
AI_PROVIDER=fake
AI_MODEL=claude-haiku-5-5
AI_HIGH_CONFIDENCE=0.6
AI_LOW_CONFIDENCE=0.4
AI_DAILY_BUDGET_USD=1.00
AI_DEDUPE_HOURS=6
# ANTHROPIC_API_KEY=

# Optional deterministic rules
NOISE_EXTRA_RULES=1
IDEA_EXPLICIT_RULE=1
GENERIC_WORDS_TO_AI=1

# Intern window: off | shadow | on
INTERN_MODE=shadow
INTERN_WINDOW=08:00-11:59
INTERN_TZ=America/Sao_Paulo
INTERN_MAX_OPEN=5
